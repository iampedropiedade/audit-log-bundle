{
    "name": "iampedropiedade/audit-log-bundle",
    "description": "Generic Doctrine entity change-tracking (audit log) Symfony bundle - framework-agnostic about which User entity or concrete AuditLog entity a consuming app uses.",
    "type": "symfony-bundle",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "doctrine/collections": "^2.0",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/orm": "^2.17 || ^3.0",
        "doctrine/persistence": "^3.0 || ^4.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/http-kernel": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/security-core": "^6.4 || ^7.0",
        "symfony/uid": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Pedropiedade\\AuditLogBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pedropiedade\\AuditLogBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
